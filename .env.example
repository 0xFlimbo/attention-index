# Copy to .env.local and insert your own credential locally.
# Never commit .env.local.
X_BEARER_TOKEN=

# Web-search discovery (pnpm sweep:web, docs/ENGINEERING.md §21). Travels in
# the X-Subscription-Token header. The vendor has no free plan and no default
# spending cap: set a cap in its dashboard before the first call. Leave empty
# and the sweep still prints its query set and its modelled cost; it refuses
# to make a request.
BRAVE_SEARCH_API_KEY=

# Google News through Serper (pnpm sweep:web -- --vendor serper-news), run
# alongside Brave. Travels in the X-API-KEY header. 2,500 card-free credits;
# the sweep reads the balance first and refuses when it cannot cover a run.
SERPER_API_KEY=

# Optional. The site's absolute canonical URL — used by metadataBase,
# sitemap.ts and robots.ts (src/lib/site-url.ts). Falls back to the
# canonical Vercel deployment (https://attention-index-theta.vercel.app)
# when unset, so this only needs setting for a future custom domain.
# docs/ENGINEERING.md §11: at most this one public env var.
NEXT_PUBLIC_SITE_URL=
